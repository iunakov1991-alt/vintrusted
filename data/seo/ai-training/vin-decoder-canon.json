{
  "canon_template": {
    "description": "Canonical VIN decoder template for all articles. DO NOT MODIFY.",
    "version": "1.0",
    "positions": {
      "1-3": {
        "name": "WMI (World Manufacturer Identifier)",
        "1": {
          "meaning": "Region/Country",
          "example": "4 = United States"
        },
        "2": {
          "meaning": "Manufacturer",
          "example": "T = Toyota"
        },
        "3": {
          "meaning": "Vehicle Type",
          "example": "1 = Passenger Car"
        }
      },
      "4-8": {
        "name": "VDS (Vehicle Descriptor Section)",
        "4": {
          "meaning": "Model Line",
          "example": "B = Camry"
        },
        "5": {
          "meaning": "Body/Engine Family",
          "example": "1 = Sedan, 4-door"
        },
        "6": {
          "meaning": "Grade/Series + Restraint System",
          "example": "1 = LE/SE trim, standard restraints"
        },
        "7": {
          "meaning": "Safety/Body Configuration",
          "example": "H = Advanced airbags"
        },
        "8": {
          "meaning": "Engine Code",
          "example": "1 = 2.5L A25A-FKS, H = 2.5L Hybrid, 6 = 3.5L V6"
        }
      },
      "9": {
        "name": "Check Digit",
        "meaning": "Mathematical validation digit",
        "example": "K, 3, X, etc."
      },
      "10": {
        "name": "Model Year",
        "meaning": "Year code",
        "mapping": {
          "2018": "J",
          "2019": "K",
          "2020": "L",
          "2021": "M",
          "2022": "N",
          "2023": "P",
          "2024": "R"
        }
      },
      "11": {
        "name": "Assembly Plant",
        "meaning": "Manufacturing facility",
        "example": "J = Georgetown, Kentucky (TMMK)"
      },
      "12-17": {
        "name": "Serial Number",
        "meaning": "Unique production sequence",
        "example": "000001-999999"
      }
    },
    "rules": {
      "1": "Positions 1-3 (WMI) are ALWAYS: Country, Manufacturer, Vehicle Type",
      "2": "Positions 4-8 (VDS) are ALWAYS: Model, Body, Grade/Restraint, Safety, Engine",
      "3": "Position 10 is ALWAYS Model Year (J=2018, K=2019, etc.)",
      "4": "NEVER change position meanings between articles",
      "5": "ALWAYS use this exact structure for all VIN decoder sections"
    }
  }
}










