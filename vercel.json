{
  "version": 2,
  "builds": [
    { "src": "api/**/*.js", "use": "@vercel/node" },
    { "src": "public/**", "use": "@vercel/static" },
    { "src": "index.html", "use": "@vercel/static" },
    { "src": "report.html", "use": "@vercel/static" },
    { "src": "success.html", "use": "@vercel/static" },
    { "src": "payment-success.html", "use": "@vercel/static" },
    { "src": "payment-cancel.html", "use": "@vercel/static" },
    { "src": "styles.css", "use": "@vercel/static" },
    { "src": "css/**", "use": "@vercel/static" },
    { "src": "js/**", "use": "@vercel/static" },
    { "src": "images/**", "use": "@vercel/static" },
    { "src": "img/**", "use": "@vercel/static" },
    { "src": "*.png", "use": "@vercel/static" },
    { "src": "*.jpg", "use": "@vercel/static" },
    { "src": "*.svg", "use": "@vercel/static" }
  ],
  "routes": [
    { "src": "/api/(.*)", "dest": "/api/$1" },
    { "src": "/api/vin-stripe.js", "dest": "/public/vin-stripe.js" },
    { "src": "/styles.css", "dest": "/styles.css" },
    { "src": "/hero-background.jpg", "dest": "/hero-background.jpg" },
    { "src": "/logo-vin-trust.png", "dest": "/logo-vin-trust.png" },
    { "src": "/logo.png", "dest": "/logo.png" },
    { "src": "/logo.svg", "dest": "/logo.svg" },
    { "src": "/report.html", "dest": "/report.html" },
    { "src": "/success.html", "dest": "/success.html" },
    { "src": "/payment-success", "dest": "/payment-success.html" },
    { "src": "/payment-cancel", "dest": "/payment-cancel.html" },
    { "src": "/css/(.*)", "dest": "/css/$1" },
    { "src": "/js/(.*)", "dest": "/js/$1" },
    { "src": "/images/(.*)", "dest": "/images/$1" },
    { "src": "/public/(.*)", "dest": "/public/$1" },
    { "src": "/(.*)", "dest": "/index.html" }
  ]
}