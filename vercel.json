{
  "version": 2,
  "builds": [
    { "src": "api/checkout.js", "use": "@vercel/node" },
    { "src": "api/stripe-webhook.js", "use": "@vercel/node" },
    { "src": "api/report.js", "use": "@vercel/node" },
    { "src": "api/health.js", "use": "@vercel/node" },
    { "src": "public/**", "use": "@vercel/static" },
    { "src": "*.html", "use": "@vercel/static" },
    { "src": "styles.css", "use": "@vercel/static" },
    { "src": "script.js", "use": "@vercel/static" },
    { "src": "logo-vin-trust.png", "use": "@vercel/static" },
    { "src": "css/**", "use": "@vercel/static" },
    { "src": "images/**", "use": "@vercel/static" },
    { "src": "js/**", "use": "@vercel/static" }
  ],
  "routes": [
    {
      "src": "/(.*)",
      "headers": { "host": "www.vintrusted.com" },
      "dest": "https://vintrusted.com/$1",
      "status": 301
    },
    { "src": "/api/checkout", "dest": "/api/checkout.js" },
    { "src": "/api/stripe-webhook", "dest": "/api/stripe-webhook.js" },
    { "src": "/api/report", "dest": "/api/report.js" },
    { "src": "/api/health", "dest": "/api/health.js" },
    { "src": "/logo-vin-trust.png", "dest": "/images/logo-vin-trust.png" },
    { "src": "/public/(.*)", "dest": "/public/$1" },
    { "src": "/css/(.*)", "dest": "/css/$1" },
    { "src": "/images/(.*)", "dest": "/images/$1" },
    { "src": "/js/(.*)", "dest": "/js/$1" },
    { "src": "/styles.css", "dest": "/styles.css" },
    { "src": "/script.js", "dest": "/script.js" },
    { "src": "/success.html", "dest": "/success.html" },
    { "src": "/report-view.html", "dest": "/report-view.html" },
    { "src": "/report.html", "dest": "/report.html" },
    { "src": "/payment-success", "dest": "/payment-success.html" },
    { "src": "/payment-cancel", "dest": "/payment-cancel.html" },
    { "src": "/(.*)", "dest": "/index.html" }
  ]
}