{
  "version": 2,
  "builds": [
    {
      "src": "api/checkout.js",
      "use": "@vercel/node"
    },
    {
      "src": "api/create-payment-intent.js",
      "use": "@vercel/node"
    },
    {
      "src": "api/create-setup-intent.js",
      "use": "@vercel/node"
    },
    {
      "src": "api/stripe-webhook.js",
      "use": "@vercel/node"
    },
    {
      "src": "api/checkout-trial-then-two-charges.js",
      "use": "@vercel/node"
    },
    {
      "src": "api/get-clearvin-report.js",
      "use": "@vercel/node"
    },
    {
      "src": "api/send-clearvin-report.js",
      "use": "@vercel/node"
    },
    {
      "src": "api/get-vin-from-setup-intent.js",
      "use": "@vercel/node"
    },
    {
      "src": "api/get-checkout-session.js",
      "use": "@vercel/node"
    },
    {
      "src": "api/send-receipt-and-report.js",
      "use": "@vercel/node"
    },
    {
      "src": "api/report.js",
      "use": "@vercel/node"
    },
    {
      "src": "api/health.js",
      "use": "@vercel/node"
    },
    {
      "src": "*.html",
      "use": "@vercel/static"
    },
    {
      "src": "**/index.html",
      "use": "@vercel/static"
    },
    {
      "src": "*.css",
      "use": "@vercel/static"
    },
    {
      "src": "*.js",
      "use": "@vercel/static"
    },
    {
      "src": "*.jpg",
      "use": "@vercel/static"
    },
    {
      "src": "*.png",
      "use": "@vercel/static"
    },
    {
      "src": "css/**",
      "use": "@vercel/static"
    },
    {
      "src": "images/**",
      "use": "@vercel/static"
    },
    {
      "src": "js/**",
      "use": "@vercel/static"
    },
    {
      "src": "*.xml",
      "use": "@vercel/static"
    },
    {
      "src": "*.txt",
      "use": "@vercel/static"
    }
  ],
  "rewrites": [
    {
      "source": "/api/checkout",
      "destination": "/api/checkout.js"
    },
    {
      "source": "/api/create-payment-intent",
      "destination": "/api/create-payment-intent.js"
    },
    {
      "source": "/api/create-setup-intent",
      "destination": "/api/create-setup-intent.js"
    },
    {
      "source": "/api/stripe-config",
      "destination": "/api/stripe-webhook.js"
    },
    {
      "source": "/api/stripe-webhook",
      "destination": "/api/stripe-webhook.js"
    },
    {
      "source": "/api/checkout-trial-then-two-charges",
      "destination": "/api/checkout-trial-then-two-charges.js"
    },
    {
      "source": "/api/get-clearvin-report",
      "destination": "/api/get-clearvin-report.js"
    },
    {
      "source": "/api/send-clearvin-report",
      "destination": "/api/send-clearvin-report.js"
    },
    {
      "source": "/api/get-vin-from-setup-intent",
      "destination": "/api/get-vin-from-setup-intent.js"
    },
    {
      "source": "/api/get-checkout-session",
      "destination": "/api/get-checkout-session.js"
    },
    {
      "source": "/api/send-receipt-and-report",
      "destination": "/api/send-receipt-and-report.js"
    },
    {
      "source": "/api/report",
      "destination": "/api/report.js"
    },
    {
      "source": "/api/health",
      "destination": "/api/health.js"
    },
    {
      "source": "/",
      "destination": "/index.html"
    },
    {
      "source": "/about-us",
      "destination": "/about-us.html"
    },
    {
      "source": "/contact",
      "destination": "/contact.html"
    },
    {
      "source": "/accident-history",
      "destination": "/accident-history.html"
    },
    {
      "source": "/title-records",
      "destination": "/title-records.html"
    },
    {
      "source": "/recall-information",
      "destination": "/recall-information.html"
    },
    {
      "source": "/sitemaps",
      "destination": "/sitemaps.html"
    }
  ]
}
