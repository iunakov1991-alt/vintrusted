{
  "version": 2,
  "builds": [
    { "src": "api/checkout.js", "use": "@vercel/node" },
    { "src": "api/create-payment-intent.js", "use": "@vercel/node" },
    { "src": "api/create-setup-intent.js", "use": "@vercel/node" },
    { "src": "api/stripe-config.js", "use": "@vercel/node" },
    { "src": "api/stripe-webhook.js", "use": "@vercel/node" },
    { "src": "api/checkout-trial-then-two-charges.js", "use": "@vercel/node" },
    { "src": "api/send-receipt-and-report.js", "use": "@vercel/node" },
    { "src": "api/report.js", "use": "@vercel/node" },
    { "src": "api/health.js", "use": "@vercel/node" },
    { "src": "public/**", "use": "@vercel/static" },
    { "src": "*.html", "use": "@vercel/static" },
    { "src": "*.css", "use": "@vercel/static" },
    { "src": "*.js", "use": "@vercel/static" },
    { "src": "*.jpg", "use": "@vercel/static" },
    { "src": "*.png", "use": "@vercel/static" },
    { "src": "css/**", "use": "@vercel/static" },
    { "src": "images/**", "use": "@vercel/static" },
    { "src": "js/**", "use": "@vercel/static" }
  ],
  "routes": [
    { "src": "/api/checkout", "dest": "/api/checkout.js" },
    { "src": "/api/create-payment-intent", "dest": "/api/create-payment-intent.js" },
    { "src": "/api/create-setup-intent", "dest": "/api/create-setup-intent.js" },
    { "src": "/api/stripe-config", "dest": "/api/stripe-config.js" },
    { "src": "/api/stripe-webhook", "dest": "/api/stripe-webhook.js" },
    { "src": "/api/checkout-trial-then-two-charges", "dest": "/api/checkout-trial-then-two-charges.js" },
    { "src": "/api/send-receipt-and-report", "dest": "/api/send-receipt-and-report.js" },
    { "src": "/api/report", "dest": "/api/report.js" },
    { "src": "/api/health", "dest": "/api/health.js" },
    { "src": "/hero-background.jpg", "dest": "/hero-background.jpg" },
    { "src": "/logo-vin-trust.png", "dest": "/images/logo-vin-trust.png" },
    { "src": "/public/(.*)", "dest": "/public/$1" },
    { "src": "/css/(.*)", "dest": "/css/$1" },
    { "src": "/images/(.*)", "dest": "/images/$1" },
    { "src": "/js/(.*)", "dest": "/js/$1" },
    { "src": "/styles.css", "dest": "/styles.css" },
    { "src": "/script.js", "dest": "/script.js" },
    { "src": "/success.html", "dest": "/success.html" },
    { "src": "/report-view.html", "dest": "/report-view.html" },
    { "src": "/report.html", "dest": "/report.html" },
    { "src": "/payment-success", "dest": "/payment-success.html" },
    { "src": "/payment-cancel", "dest": "/payment-cancel.html" },
    { "src": "/(.*)", "dest": "/index.html" }
  ]
}