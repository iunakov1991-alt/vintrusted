{
  "version": "1.0.0",
  "description": "Autonomous SEO Machine for VIN service (EN+ES, static pages, Vercel).",
  "core": {
    "status": "IMPLEMENTED",
    "modules": [
      { "name": "Build orchestrator", "path": "scripts/build-seo-full-5.js", "role": "orchestrator", "lang": "BOTH", "status": "implemented" },
      { "name": "Build pages pipeline", "path": "scripts/build-seo-pages.js", "role": "orchestrator", "lang": "BOTH", "status": "implemented" },
      { "name": "Massive generator", "path": "generate-massive-seo-articles.js", "role": "generator", "lang": "BOTH", "status": "implemented" },
      { "name": "Knowledge graph generator", "path": "generate-knowledge-graph-pages.js", "role": "generator", "lang": "BOTH", "status": "implemented" },
      { "name": "Page data engine", "path": "scripts/seo-content-engine.js", "role": "engine", "lang": "BOTH", "status": "implemented" },
      { "name": "SEO template", "path": "scripts/seo-template.js", "role": "renderer", "lang": "BOTH", "status": "implemented" },
      { "name": "Sitemap batcher", "path": "scripts/seo-sitemap-batcher.js", "role": "sitemap", "lang": "BOTH", "status": "implemented" },
      { "name": "Dashboard builder", "path": "scripts/dashboard/build-dashboard-data.js", "role": "telemetry", "lang": "N/A", "status": "implemented" }
    ],
    "buildCommands": [
      "npm run build:seo",
      "npm run build:seo:rl",
      "npm run build:seo:no-rl",
      "npm run build:seo:legacy",
      "npm run vercel-build",
      "npm run dashboard:build",
      "npm run rl:train",
      "npm run rl:auto",
      "npm run autonomy:daily"
    ]
  },
  "extensions": {
    "aiContent": {
      "status": "PLANNED",
      "details": "В репозитории нет scripts/ai/* или LLM-интеграций; план описан в docs/seo-machine/04_AUTONOMY_AND_AI.md."
    },
    "reinforcementLearning": {
      "status": "PARTIAL",
      "details": "scripts/rl/{reward-model,policy-updater,rl-train-and-apply,auto-gsc-train,policy-engine,extract-gsc-from-zip,prepare-gsc-csv,fetch-gsc-api}.js + config/lang-policy.json, config/cluster-policy.json."
    },
    "knowledgeGraph": {
      "status": "IMPLEMENTED",
      "details": "generate-knowledge-graph-pages.js, scripts/seo-kg-engine.js, scripts/seo-kg-template.js строят guides/fraud/DMV страницы и перелинковку."
    }
  },
  "dashboards": [
    {
      "route": "/internal/seo-autonomy-9d3f7c.html",
      "file": "public/internal/seo-autonomy-9d3f7c.html",
      "dataSource": "public/internal/dashboard-data.json",
      "status": "PARTIAL"
    }
  ],
  "env": [
    { "name": "SEO_TARGET_PAGES", "usedIn": ["generate-massive-seo-articles.js", "generate-knowledge-graph-pages.js"], "min": "1", "max": ">=500000 (default)", "notes": "Целевой объём страниц за прогон; влияет на расчёт задач." },
    { "name": "SEO_MAX_PAGES_PER_BUILD", "usedIn": ["generate-massive-seo-articles.js", "generate-knowledge-graph-pages.js"], "min": "1", "max": "ограничено ресурсами", "notes": "Жёсткий лимит страниц за запуск (default = targetPages)." },
    { "name": "SEO_WRITE_BATCH_SIZE", "usedIn": ["generate-massive-seo-articles.js"], "min": "50", "max": "1000+", "notes": "Размер батча записи HTML (default 400)." },
    { "name": "SEO_WRITE_CONCURRENCY", "usedIn": ["generate-massive-seo-articles.js"], "min": "1", "max": "CPU ядра", "notes": "Количество параллельных fs операций (default 8)." },
    { "name": "SEO_BASE_URL", "usedIn": ["scripts/seo-template.js", "scripts/seo-sitemap-batcher.js", "scripts/seo-kg-engine.js", "scripts/seo-kg-template.js"], "min": "https://...", "max": "—", "notes": "Формирует canonical, hreflang и sitemap ссылки (default https://vintrusted.com)." },
    { "name": "SEO_URLS_PER_SITEMAP", "usedIn": ["scripts/seo-sitemap-batcher.js"], "min": "1000", "max": "50000", "notes": "Максимум URL в части sitemap (default 30000)." },
    { "name": "SEO_TARGET_FULL_EXPOSURE_DAYS", "usedIn": ["scripts/seo-sitemap-batcher.js"], "min": "30", "max": "365", "notes": "Через сколько дней раскрыть весь массив (default 90)." },
    { "name": "SEO_MIN_SITEMAPS_PER_DAY", "usedIn": ["scripts/seo-sitemap-batcher.js"], "min": "1", "max": "SEO_MAX_SITEMAPS_PER_DAY", "notes": "Минимум частей в сутки (default 1)." },
    { "name": "SEO_MAX_SITEMAPS_PER_DAY", "usedIn": ["scripts/seo-sitemap-batcher.js"], "min": "1", "max": "100", "notes": "Максимум частей в сутки (default 40)." },
    { "name": "SEO_LAUNCH_DATE", "usedIn": ["scripts/seo-sitemap-batcher.js"], "min": "YYYY-MM-DD", "max": "—", "notes": "Дата старта для прогрева (default 2025-12-10)." },
    { "name": "SEO_ENABLE_RL", "usedIn": ["scripts/build-seo-full-5.js"], "min": "false", "max": "true", "notes": "Включает обязательный rl-train-and-apply в конце билда." },
    { "name": "SEO_GLOBAL_MAX_NEW_PAGES_PER_BUILD", "usedIn": ["scripts/seo-config.js"], "min": "1", "max": "2000000", "notes": "Безопасный предел новых страниц (default 2000000)." },
    { "name": "SEO_GLOBAL_MAX_EXPOSE_PER_DAY", "usedIn": ["scripts/seo-config.js"], "min": "1", "max": "300000", "notes": "Максимум раскрываемых URL в сутки (default 300000)." },
    { "name": "SEO_PENALTY_MODE", "usedIn": ["scripts/seo-config.js"], "min": "off", "max": "on", "notes": "Если on — замедляет раскрытие sitemap." },
    { "name": "SEO_EN_GA_MEASUREMENT_ID / SEO_ES_GA_MEASUREMENT_ID (и связанные ADS/FB)", "usedIn": ["scripts/seo-analytics.js"], "min": "—", "max": "—", "notes": "Инжектируются в шаблон для аналитики." },
    { "name": "SEO_QUALITY_LOG / SEO_QUALITY_LOG_PATH", "usedIn": ["scripts/seo-text-quality.js"], "min": "0", "max": "1", "notes": "Включают логирование качества страниц." }
  ],
  "notes": "Cursor: обнови этот файл реальными данными, НЕ ВЫДУМЫВАЯ НЕСУЩЕСТВУЮЩИЕ МОДУЛИ."
}

