{
  "name": "vintrusted",
  "version": "1.0.0",
  "description": "VIN Trusted website with Stripe integration",
  "main": "index.html",
  "scripts": {
    "monster8:dashboard": "node monster-8.0/dashboard/server-8.0.js",
    "monster8:health": "node monster-8.0/dashboard/server-health.js",
    "monster8:watchdog": "node scripts/watchdog_orchestrator.js",
    "monster8:backup": "bash scripts/auto_backup.sh",
    "monster:runner": "NODE_ENV=production node scripts/local_runner.js",
    "monster:dashboard:local": "node scripts/monster8_local_dashboard_server.js",
    "vercel-build": "echo 'SEO pages are generated locally on Mac via Monster 7.1 dashboard. Skipping build-time generation.'",
