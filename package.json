    "@vercel/speed-insights": "^1.2.0",
    "body-parser": "^1.20.3",
    "cors": "^2.8.5",
    "express": "^4.22.1",
    "jsdom": "^24.0.0",
    "multer": "^2.0.2",
    "openai": "^4.104.0",
    "pdf-parse": "^1.1.1",
    "socket.io": "^4.8.1",
    "stripe": "^14.0.0"
  },
  "devDependencies": {
    "clean-css-cli": "^5.6.3",
    "cssnano": "^7.1.2",
    "nodemon": "^3.1.0",
